lantern-alley-artifact.html

# Scratch output
output/

node_modules/
.DS_Store
Thumbs.db

# Superpowers tooling scratch state
.superpowers/

# Local Edge TTS environment used by generate-audio.py. Not a game dependency.
.audio-python/

# The raw images supplied for the home and garden. 52MB of unprocessed source
# PNGs that are cut down into the production assets under assets/home/decor,
# /garden, /exterior and /interior. Committing them would put 52MB in the
# history forever for files the game never loads - pwa.test.mjs already asserts
# the service worker does not ship them.
assets/home/incoming-user/

# Scratch space for looking at the supplied images - contact sheets and copies
# of the same source PNGs that assets/home/incoming-user/ already holds. 52MB
# of it reached a commit once; it is working state, not part of the game.
.tmp-image-audit/
